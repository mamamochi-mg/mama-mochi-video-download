BOT_TOKEN=8643438996:AAGQs_rlp0fU1d8o8yrLsskQNQaS-hlda2k

# Admin monitoring destination. Use a private admin chat/group ID.
ADMIN_CHAT_ID=8193986737
# Optional admin Telegram user IDs, comma-separated, for /admin command.
ADMIN_USER_IDS=8193986737
# Use a Railway Volume mounted at /app/data for persistence.
DB_PATH=data/bot.sqlite3

# Optional: limit use to specific Telegram user IDs, comma-separated.
# Leave empty to allow everyone who can message the bot.
ALLOWED_USER_IDS=

# Optional limits
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT_SECONDS=900
UPLOAD_TIMEOUT_SECONDS=1800
# 1 = upload video as document to avoid Telegram-side video processing and finish faster.
FAST_UPLOAD_MODE=1
MAX_URL_LENGTH=2000
