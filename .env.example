# Required: create a bot with @BotFather and paste its token here
BOT_TOKEN=123456789:replace_this_token

# Optional: limit use to specific Telegram user IDs, comma-separated.
# Leave empty to allow everyone who can message the bot.
ALLOWED_USER_IDS=

# Optional limits
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_URL_LENGTH=2000
